{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 595 --data-binary @- http://127.0.0.1:47823/permission 2>/dev/null || true",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -o /dev/null --data-binary @- http://127.0.0.1:47823/event 2>/dev/null || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -o /dev/null --data-binary @- http://127.0.0.1:47823/event 2>/dev/null || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -o /dev/null --data-binary @- http://127.0.0.1:47823/event 2>/dev/null || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -o /dev/null --data-binary @- http://127.0.0.1:47823/event 2>/dev/null || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -o /dev/null --data-binary @- http://127.0.0.1:47823/event 2>/dev/null || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 2 -o /dev/null --data-binary @- http://127.0.0.1:47823/event 2>/dev/null || true",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
